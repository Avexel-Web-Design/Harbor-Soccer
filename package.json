{
  "name": "harbor-soccer",
  "version": "1.0.0",
  "type": "module",
  "description": "Harbor Soccer Inc. website",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "format": "prettier --write \"**/*.{html,js,json,css,md}\"",
    "lint:js": "eslint js/",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:html": "html-validate \"*.html\"",
    "check": "npm run lint:js && npm run lint:css && npm run lint:html"
  },
  "keywords": [
    "soccer",
    "youth-sports",
    "harbor-springs"
  ],
  "author": "Harbor Soccer Inc.",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.22.0",
    "html-validate": "^10.1.2",
    "prettier": "^3.5.3",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^39.0.1"
  }
}
